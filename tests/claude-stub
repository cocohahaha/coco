#!/usr/bin/env python3
"""claude CLI stub for the smoke test.

Speaks the ``--output-format stream-json`` protocol coco's provider layer parses
(a few text deltas, then a result event) and answers each prompt type with fixed
output that passes coco's validation – in Chinese or English depending on the
prompt set that was used. Never touches the network.
"""
import json
import re
import sys

data = sys.stdin.read()
zh = "只依据转写证据" in data or "请" in data[:4000] or "维护一份" in data


def emit(text: str) -> None:
    # two deltas so streaming code paths are exercised, then the final result
    cut = max(1, len(text) // 2)
    for part in (text[:cut], text[cut:]):
        print(json.dumps({"type": "stream_event", "event": {
            "type": "content_block_delta", "index": 0,
            "delta": {"type": "text_delta", "text": part}}}, ensure_ascii=False))
    print(json.dumps({"type": "result", "subtype": "success", "is_error": False,
                      "result": text}, ensure_ascii=False))


if "PERSONAL NAMES AND PROPER NOUNS" in data or "人名与专有名词】" in data:
    m = re.search(r"<(transcript|report)>\n(.*)\n</\1>", data, re.S)
    emit((m.group(2) if m else data) + "\n")
elif "<current_glossary>" in data:
    if zh:
        emit("# 词表\n\n## 人名\n- 林炜（误写：林伟）｜产品负责人\n\n"
             "## 专有名词\n- 智舱（误写：置仓）｜车机项目\n- GEO｜生成引擎优化")
    else:
        emit("# Glossary\n\n## Names\n- Lin Wei (misheard: Lin Way) | product lead\n\n"
             "## Terms\n- SmartCabin (misheard: Smart Cabinet) | cockpit project\n- GEO | generative engine optimisation")
elif "<current_memory>" in data and ("NO_CHANGE" in data):
    # incremental long-term memory: only new / updated entries
    if zh:
        emit("## 人物\n- **林炜**：产品负责人，主推智舱二期\n- **张三**：IT 部门\n\n"
             "## 项目与客户\n- **智舱项目**：二期排期讨论中\n\n"
             "## 承诺与决定\n- 林炜 承诺 8/25 前给出二期排期 [test] 状态：进行中\n\n"
             "## 术语与说法\n- **智舱**：车机智能座舱项目")
    else:
        emit("## People\n- **Lin Wei**: product lead, pushing SmartCabin phase 2\n- **Zhang San**: IT department\n\n"
             "## Projects & clients\n- **SmartCabin**: phase-2 schedule under discussion\n\n"
             "## Commitments & decisions\n- Lin Wei committed to a phase-2 schedule by 8/25 [test] status: in progress\n\n"
             "## Terms & phrasing\n- **SmartCabin**: in-car cockpit project")
elif "<current_memory>" in data:
    # full rewrite / compaction
    if zh:
        emit("# 长期记忆\n\n## 人物\n- **林炜**：产品负责人\n- **张三**：IT 部门\n- **李四**：数据权限\n\n"
             "## 项目与客户\n- **智舱项目**：二期排期讨论中\n\n"
             "## 承诺与决定\n- 林炜 承诺 8/25 前给出二期排期 [test] 状态：进行中\n\n"
             "## 术语与说法\n- **智舱**：车机智能座舱项目")
    else:
        emit("# Long-term memory\n\n## People\n- **Lin Wei**: product lead\n\n## Projects & clients\n- **SmartCabin**: phase 2\n\n"
             "## Commitments & decisions\n- Lin Wei: schedule by 8/25 [test] in progress\n\n## Terms & phrasing\n- **SmartCabin**: cockpit")
elif "Reply with exactly one word" in data:
    emit("pong")
else:
    emit("# 模拟标题\n\n## 分析\n- 这是 stub claude 的输出，用于验证链路" if zh
         else "# Stub title\n\n## Analysis\n- stub claude output for the smoke test")
