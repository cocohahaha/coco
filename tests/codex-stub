#!/usr/bin/env python3
"""codex CLI stub for the smoke test: speaks the bits of `codex exec --json`, `codex login status`
and `codex debug models` that coco's codex-cli channel uses. Never touches the network.

COCO_CODEX_STUB=legacy   reject the modern flags like an old codex (coco must retry without them)
COCO_CODEX_STUB=nologin  report "not logged in" and fail every turn
"""
import json
import os
import sys

mode = os.environ.get("COCO_CODEX_STUB", "")
args = sys.argv[1:]

if args[:2] == ["login", "status"]:
    if mode == "nologin":
        print("Not logged in")
        sys.exit(1)
    print("Logged in using ChatGPT")
    sys.exit(0)

if args[:2] == ["debug", "models"]:
    print(json.dumps({"models": [
        {"slug": "stub-hidden", "display_name": "Hidden", "visibility": "hide", "priority": 1},
        {"slug": "stub-pro", "display_name": "Stub Pro", "visibility": "list", "priority": 2,
         "description": "the careful one", "context_window": 272000,
         "supported_reasoning_levels": [{"effort": "low"}, {"effort": "high"}]},
        {"slug": "stub-fast", "display_name": "Stub Fast", "visibility": "list", "priority": 5},
    ]}))
    sys.exit(0)

if args[:1] == ["exec"]:
    if mode == "legacy" and "--ephemeral" in args:
        print("error: unexpected argument '--ephemeral' found", file=sys.stderr)
        sys.exit(2)
    prompt = sys.stdin.read()
    print(json.dumps({"type": "thread.started", "thread_id": "stub"}), flush=True)
    print(json.dumps({"type": "turn.started"}), flush=True)
    if mode == "nologin":
        print(json.dumps({"type": "turn.failed", "error": {"message": "401 Unauthorized: not logged in"}}), flush=True)
        sys.exit(1)
    if "Reply with exactly one word" in prompt:
        text = "pong"
    else:
        model = args[args.index("-m") + 1] if "-m" in args else "default"
        text = f"# Stub codex\n\n- model: {model}\n- no-tools preamble: {'Do not run' in prompt}"
    print(json.dumps({"type": "item.completed", "item": {"id": "i0", "type": "reasoning", "text": "thinking"}}), flush=True)
    print(json.dumps({"type": "item.completed", "item": {"id": "i1", "type": "agent_message", "text": text}}), flush=True)
    print(json.dumps({"type": "turn.completed", "usage": {"input_tokens": 1, "output_tokens": 1}}), flush=True)
    sys.exit(0)

print("unsupported: " + " ".join(args), file=sys.stderr)
sys.exit(2)
